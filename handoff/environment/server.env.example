# Names and non-secret defaults only; do NOT activate production by copying this file.
# Review the migration and configure deployed Functions environment deliberately.
ORIN_ACCOUNT_SECURITY_ENABLED=false
ORIN_SUPPORT_AI_ENABLED=false
ORIN_SUPPORT_AI_PROVIDER=gemini
ORIN_SUPPORT_AI_MODEL=gemini-3.5-flash-lite
ORIN_SUPPORT_AI_MAX_TOKENS=700
