{
  "hosting": {
    "site": "orin-99951",
    "public": "firebase-security-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/register",
        "destination": "https://orin-trader.top/register",
        "type": 301
      },
      {
        "source": "/login",
        "destination": "https://orin-trader.top/login",
        "type": 301
      },
      {
        "source": "/referral{,/**}",
        "destination": "https://orin-trader.top/referral",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/api/security/**",
        "function": {
          "functionId": "orinSecurity",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/payments/**",
        "function": {
          "functionId": "orinPayments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "orinApi",
          "region": "europe-west1"
        }
      },
      {
        "source": "/orin.apk",
        "destination": "/orin-app.bin"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      },
      {
        "source": "**/*.mobileconfig",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-apple-aspen-config; charset=utf-8"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"orin.mobileconfig\""
          }
        ]
      },
      {
        "source": "/orin-app.bin",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"ORIN-1.6.2.apk\""
          }
        ]
      },
      {
        "source": "/orin.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"ORIN-1.6.2.apk\""
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "firebase-functions",
      "codebase": "orin",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*debug.log",
        "src",
        "build.mjs",
        "*.test.mjs",
        "lib/*test*",
        "lib/*test*.map"
      ]
    }
  ],
  "firestore": {
    "rules": "firebase-security-160.rules",
    "indexes": "firebase-security-161.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
