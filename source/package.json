{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:firebase": "node scripts/build-dist.mjs render",
    "deploy:firebase": "firebase deploy --project orin-99951 --config firebase-web/firebase.json --only hosting,firestore:rules",
    "test:firebase": "firebase emulators:exec --project demo-orin-auth --config firebase-web/firebase.json --only auth,firestore \"node --experimental-strip-types --test firebase-web/rules.test.mjs firebase-web/auth-smoke.test.mjs\"",
    "build:firebase-original": "vite build --config firebase-app/vite.config.mts && npm --prefix firebase-functions run build",
    "deploy:firebase-original": "firebase deploy --project orin-99951 --config firebase.original.json --only functions,firestore,hosting",
    "build:firebase-spark": "node scripts/build-dist.mjs spark",
    "preview:firebase-spark": "firebase hosting:channel:deploy spark-review --expires 7d --project orin-99951 --config firebase.spark.json",
    "build:firebase-security": "node scripts/build-dist.mjs security",
    "build:server": "node scripts/build-dist.mjs server",
    "build:render": "node scripts/build-dist.mjs render",
    "deploy:render-hosting": "firebase deploy --project orin-99951 --config firebase.hosting.json --only hosting,firestore:rules,firestore:indexes",
    "deploy:production": "firebase deploy --project orin-99951 --only functions,firestore,hosting",
    "deploy:rules": "firebase deploy --project orin-99951 --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --project orin-99951 --only functions",
    "deploy:hosting": "firebase deploy --project orin-99951 --only hosting"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.4.2",
    "jspdf": "4.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.32.1",
    "json-rpc-2.0": "1.7.1",
    "playwright": "^1.64.0",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
