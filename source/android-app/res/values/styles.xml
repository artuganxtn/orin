<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OrinTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0788FF</item>
        <item name="android:windowBackground">@drawable/orin_launch</item>
        <item name="android:statusBarColor">#EDF4FF</item>
        <item name="android:navigationBarColor">#EDF4FF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="OrinThemeDark" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0788FF</item>
        <item name="android:windowBackground">@drawable/orin_launch_dark</item>
        <item name="android:statusBarColor">#06111F</item>
        <item name="android:navigationBarColor">#06111F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
